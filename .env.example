# Browser chain reads use the same-origin Koios proxy configured in Vite.
# Do not place a real Blockfrost project key in a VITE_* variable; Vite-exposed
# values are readable from the shipped browser bundle.

# Set only after usdm-settlement.compact is actually deployed on Midnight Preview.
# Leaving this empty keeps Compact settlement and receipt stages visibly locked.
VITE_MIDNIGHT_SETTLEMENT_CONTRACT_ADDRESS=
